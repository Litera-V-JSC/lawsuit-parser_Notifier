# Parser API
PARSER_API_URL=http://company_parser_api:5050
PARSER_API_KEY=

# Subscribers config file (mounted from host)
SUBSCRIBERS_FILE=/data/subscribers.json

# SMTP server
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=notifier@example.com
SMTP_PASSWORD=your_password_here
SMTP_FROM_ADDRESS=notifier@example.com
SMTP_FROM_NAME=Company Parser
SMTP_USE_SSL=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/email.log
